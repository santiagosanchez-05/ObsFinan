# Copiá este archivo a ".env" (en esta misma carpeta) y completá los valores
# reales. El ".env" real NUNCA se sube a git (ya está en .gitignore) — pedile
# los valores a Santiago por privado.

PORT=3000

# Base de datos remota compartida (MariaDB en AlwaysData)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Cualquier string largo y random sirve — se usa para firmar los JWT
JWT_SECRET=

# Cuenta de Gmail que envía los correos de recuperación de contraseña
MAIL_USER=
MAIL_PASSWORD=
