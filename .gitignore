# Dependencias
node_modules

# Variables de entorno — backend/.env SÍ se versiona a propósito (decisión
# del equipo, entorno de desarrollo compartido) para que todos tengan las
# mismas credenciales apenas clonan, sin pedirlas por privado.
.env
.env.local
frontend/.env
!backend/.env

# Build
dist
dist-ssr

# Cobertura de tests (Jest / Vitest)
coverage

# Logs
logs
*.log
npm-debug.log*

# Config de Claude Code (herramienta personal — nadie más del equipo la usa)
.claude/

# Editor / sistema operativo
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
